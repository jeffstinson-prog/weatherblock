{
  "name": "weatherblock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:node": "E2E_ADAPTER=node astro build",
    "start:node": "node scripts/start-node.mjs",
    "check": "astro check",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:db && npm run build:node && npm run test:e2e",
    "lhci": "lhci autorun",
    "db:local": "bash scripts/db-local.sh",
    "build:test": "E2E_ADAPTER=node PUBLIC_SUPABASE_URL=https://test-project.supabase.co PUBLIC_SUPABASE_ANON_KEY=test-anon-key astro build",
    "test:content": "vitest run --project content",
    "test:assistant": "vitest run --project assistant"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/netlify": "^8.2.14",
    "@astrojs/node": "^11.1.14",
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@supabase/auth-js": "^2.119.2",
    "astro": "^7.4.13",
    "jose": "^6.2.18",
    "js-yaml": "^5.5.0",
    "marked": "^18.2.1",
    "postgres": "^4.1.1",
    "preact": "^11.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@netlify/functions": "^6.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.63.0"
    }
  }
}
