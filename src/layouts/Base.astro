---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import figtreeUrl from '../assets/fonts/figtree-latin-wght-normal.woff2?url';
import frauncesUrl from '../assets/fonts/fraunces-latin-wght-normal.woff2?url';
import { facts, indexable } from '../facts';

interface Props {
  title: string;
  description: string;
  /** Keep this page out of search results even after launch (owner app, manage links). */
  noindex?: boolean;
  /** Structured data for this page (schema.org JSON-LD). */
  jsonLd?: object | object[];
  /** Hide the site header and footer (owner app). */
  bare?: boolean;
  /** A page with one job (booking, the estimate, a private link): a quiet header, no menu, no action bar. */
  focus?: boolean;
}

const { title, description, noindex = false, jsonLd, bare = false, focus = false } = Astro.props;
const name = facts.business.name;
const fullTitle = title === name ? name : `${title} | ${name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${facts.web.domain}`).href;
const robots = noindex || !indexable() ? 'noindex, nofollow' : 'index, follow';
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const shareImage = new URL('/brand/share.png', canonical).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={figtreeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/mark-white-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- The picture a shared link shows in iMessage, Facebook, LinkedIn and others (scripts/build-share-image.mjs). -->
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name} logo`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="format-detection" content="telephone=no" />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    {!bare && <Header focus={focus} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer focus={focus} />}
    {!bare && !focus && <StickyCta />}
    {!bare && <script src="../scripts/found-us.ts"></script>}
  </body>
</html>
