---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { facts, indexable } from '../facts';

interface Props {
  title: string;
  description: string;
  /** Keep this page out of search results even after launch (owner app, manage links). */
  noindex?: boolean;
  /** Structured data for this page (schema.org JSON-LD). */
  jsonLd?: object | object[];
  /** Hide the site header and footer (owner app). */
  bare?: boolean;
}

const { title, description, noindex = false, jsonLd, bare = false } = Astro.props;
const name = facts.business.name;
const fullTitle = title === name ? name : `${title} | ${name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${facts.web.domain}`).href;
const robots = noindex || !indexable() ? 'noindex, nofollow' : 'index, follow';
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1c25" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/mark-white-180.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/icons/mark-white-512.png', canonical).href} />
    <meta name="format-detection" content="telephone=no" />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    {!bare && <Header />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    {!bare && <script src="../scripts/found-us.ts"></script>}
  </body>
</html>
