---
import Legal from '../components/Legal.astro';
import { facts } from '../facts';
const { contact } = facts;
---

<Legal title="Accessibility" description="Our goal is a website everyone can use." updated="2026-11-19">
  <p>We want everyone to be able to book an inspection and get answers on this site, including people who use screen readers, zoom, keyboards or voice control.</p>
  <h2>What we aim for</h2>
  <ul>
    <li>WCAG 2.2 level AA</li>
    <li>Large buttons and text that hold up on small phones</li>
    <li>Strong contrast between text and background on every page</li>
    <li>No motion when your device asks for reduced motion</li>
    <li>Error messages that say how to fix the problem</li>
  </ul>
  <p>Every change to the site is checked by automated accessibility tests before it goes live.</p>
  <h2>Tell us if something doesn't work</h2>
  <p>Call or text {contact.phone}, or email <a href={`mailto:${contact.email}`}>{contact.email}</a>. We'll fix it, and we'll help you book in the meantime.</p>
</Legal>
