---
import Base from '../layouts/Base.astro';
import BookCall from '../components/BookCall.astro';
import BookCard from '../components/BookCard.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { facts, smsHref, telHref } from '../facts';
const { business, serviceArea, contact } = facts;
const tel = telHref();
const sms = smsHref();
---

<Base title="Service area" description={`We serve ${serviceArea.summary}.`}>
  <PageHero title="Service area" lede={`We serve ${serviceArea.summary}.`} />

  <div class="section tight">
    <div class="wrap split">
      <div>
        <ul class="places">
          <li>
            <span class="icon-badge"><Icon name="map-pin" size={22} /></span>
            <span>
              <span class="label">Based in</span>
              <strong>{business.city}, {business.state}</strong>
            </span>
          </li>
          {serviceArea.counties.length > 0 && (
            <li>
              <span class="icon-badge"><Icon name="map" size={22} /></span>
              <span>
                <span class="label">We serve</span>
                <strong>{serviceArea.counties.map((c) => `${c} County`).join(', ')}{serviceArea.state && `, ${serviceArea.state}`}</strong>
              </span>
            </li>
          )}
        </ul>

        <div class="card unsure">
          <h2>Not sure if your home is in our area?</h2>
          {tel ? (
            <>
              <p class="muted">{sms ? 'Call or text' : 'Call'} {contact.phone} and we'll tell you.</p>
              <div class="actions">
                <a class="btn secondary" href={tel}>
                  <Icon name="phone" size={18} />
                  Call {contact.phone}
                </a>
                {sms && (
                  <a class="btn secondary" href={sms}>
                    <Icon name="message-square" size={18} />
                    Text us
                  </a>
                )}
              </div>
            </>
          ) : (
            <p class="muted">Ask us.</p>
          )}
        </div>
      </div>

      <aside class="side" aria-label="Book an inspection">
        <BookCard />
      </aside>
    </div>
  </div>

  <BookCall />
</Base>

<style>
  .places {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: grid;
    gap: 0.85rem;
  }
  .places li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--card);
    box-shadow: var(--shadow-1);
  }
  .places .label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .places strong {
    font-family: var(--font-display);
    font-size: var(--h3);
    font-weight: 600;
    line-height: 1.25;
  }
  .unsure {
    padding: 1.5rem;
    background: var(--mist);
    border-color: transparent;
    box-shadow: none;
  }
  .unsure h2 {
    font-size: var(--h3);
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }
  .unsure p {
    margin: 0;
  }
  .unsure .actions {
    margin-bottom: 0;
  }
  @media (min-width: 40rem) {
    .places {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
