---
import Base from '../../layouts/Base.astro';
import ManageApp from '../../booking/ManageApp';
import '../../styles/booking.css';
import { facts, telHref } from '../../facts';

const props = {
  businessName: facts.business.name,
  phone: facts.contact.phone,
  phoneHref: telHref(),
  bookLabel: facts.derived.bookLabel,
  domain: facts.web.domain,
};
---

<Base title="Your inspection" description="See, change or cancel your inspection." noindex focus>
  <div class="flow">
    <div class="wrap">
      <div class="flow-main">
        <header class="flow-head">
          <h1>Your inspection</h1>
        </header>
        <ManageApp client:load {...props} />
        <noscript>
          <p>This page needs JavaScript. Call or text {facts.contact.phone} to change or cancel.</p>
        </noscript>
      </div>
    </div>
  </div>
</Base>
