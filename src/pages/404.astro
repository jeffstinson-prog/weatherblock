---
import Base from '../layouts/Base.astro';
import { facts, telHref } from '../facts';
---

<Base title="Page not found" description="That page isn't here." noindex>
  <section class="section">
    <div class="wrap prose">
      <h1>That page isn't here</h1>
      <p>It may have moved. Try one of these:</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/book/">{facts.derived.bookLabel}</a></li>
        <li><a href="/help/">Help center</a></li>
        {telHref() && <li><a href={telHref()}>Call {facts.contact.phone}</a></li>}
      </ul>
    </div>
  </section>
</Base>
