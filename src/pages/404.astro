---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { facts, telHref } from '../facts';
const tel = telHref();
---

<Base title="Page not found" description="That page isn't here." noindex>
  <PageHero title="That page isn't here" lede="It may have moved. Try one of these." />

  <div class="section tight">
    <div class="wrap">
      <ul class="rows">
        <li>
          <a href="/">
            Home
            <Icon name="chevron-right" size={20} />
          </a>
        </li>
        <li>
          <a href="/book/">
            {facts.derived.bookLabel}
            <Icon name="chevron-right" size={20} />
          </a>
        </li>
        <li>
          <a href="/help/">
            Help center
            <Icon name="chevron-right" size={20} />
          </a>
        </li>
        {tel && (
          <li>
            <a href={tel}>
              Call {facts.contact.phone}
              <Icon name="chevron-right" size={20} />
            </a>
          </li>
        )}
      </ul>
    </div>
  </div>
</Base>

<style>
  .rows {
    max-width: var(--measure);
  }
</style>
