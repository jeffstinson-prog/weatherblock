---
import Base from '../../layouts/Base.astro';
import AskCard from '../../components/AskCard.astro';
import BookCall from '../../components/BookCall.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { getArticle, helpArticles } from '../../help/load';
import { topicId } from '../../help/topics';

export function getStaticPaths() {
  return helpArticles.map((a) => ({ params: { slug: a.slug } }));
}

const article = getArticle(Astro.params.slug!)!;
const related = article.related.map((s) => getArticle(s)!).filter(Boolean);
const description = article.text.split('\n')[0]!.slice(0, 155);
---

<Base title={article.question} description={description}>
  <PageHero
    title={article.question}
    crumbs={[
      { href: '/help/', label: 'Help center' },
      { href: `/help/#${topicId(article.topic)}`, label: article.topic },
    ]}
  />

  <div class="section tight">
    <div class="wrap split">
      <article>
        <div class="answer prose" set:html={article.html} />

        {article.sources.length > 0 && (
          <aside class="sources" aria-labelledby="sources-h">
            <h2 id="sources-h">Sources</h2>
            <ul>
              {article.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener">
                    <span>{s.label}</span>
                    <Icon name="arrow-up-right" size={16} />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}

        {related.length > 0 && (
          <nav class="related" aria-labelledby="related-h">
            <h2 id="related-h">Related questions</h2>
            <ul class="rows">
              {related.map((r) => (
                <li>
                  <a href={`/help/${r.slug}/`}>
                    {r.question}
                    <Icon name="chevron-right" size={20} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <p class="back">
          <a class="more-link" href="/help/">
            <Icon name="arrow-left" size={18} />
            All questions
          </a>
        </p>
      </article>

      <aside class="side" aria-label="Ask us">
        <AskCard />
      </aside>
    </div>
  </div>

  <BookCall heading="Want us to take a look?" />
</Base>

<style>
  article {
    max-width: var(--measure);
  }
  /* The first paragraph is the short answer: set it a size up. */
  .answer :global(> p:first-child) {
    font-size: var(--text-l);
    line-height: 1.5;
    color: var(--ink);
  }
  .answer :global(p),
  .answer :global(li) {
    color: var(--ink-2);
  }
  .answer :global(strong) {
    color: var(--ink);
  }
  .answer :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: var(--text-s);
  }
  .answer :global(th),
  .answer :global(td) {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .answer :global(th) {
    font-weight: 700;
    color: var(--ink);
    border-bottom-color: var(--line-strong);
  }
  .answer :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.25rem 0 0.25rem 1.15rem;
    border-left: 3px solid var(--logo-green);
    color: var(--ink-2);
  }

  h2 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.85rem;
  }
  .sources,
  .related {
    margin-top: 2.5rem;
  }
  .sources {
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius-l);
    background: var(--sand);
  }
  .sources ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.15rem;
    font-size: var(--text-s);
  }
  .sources a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding-block: 0.3rem;
  }
  .sources :global(.icon) {
    flex: none;
  }
  .related .rows {
    margin: 0;
  }
  .back {
    margin: 2rem 0 0;
  }
  .back .more-link:hover :global(.icon) {
    transform: translateX(-3px);
  }
</style>
