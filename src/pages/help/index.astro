---
import Base from '../../layouts/Base.astro';
import BookCall from '../../components/BookCall.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { byTopic, helpArticles, topArticles } from '../../help/load';
import { topicIcon, topicId } from '../../help/topics';
import type { SearchDoc } from '../../help/search';

const groups = byTopic();
const top = topArticles();
const index: SearchDoc[] = helpArticles.map((a) => ({ slug: a.slug, q: a.question, k: a.keywords.join(' '), t: a.text }));
---

<Base title="Help center" description="Plain answers about roof inspections, storm damage, insurance claims, financing and more.">
  <PageHero title="Help center" lede="One plain answer per question.">
    <form class="search" role="search" action="/help/" method="get" data-search>
      <label for="help-q">Search the answers</label>
      <div class="search-field">
        <Icon name="search" size={22} />
        <input id="help-q" name="q" type="search" autocomplete="off" enterkeyhint="search" placeholder="For example: insurance, leak, cost" />
      </div>
      <p class="hint" id="help-status" aria-live="polite"></p>
      <ol class="rows results" id="help-results" hidden></ol>
    </form>
  </PageHero>
  <script type="application/json" id="help-index" set:html={JSON.stringify(index)} />

  <div class="section tight under-search">
    <div class="wrap">
      <nav class="topics" aria-label="Topics">
        <ul>
          {groups.map((g) => (
            <li>
              <a href={`#${topicId(g.topic)}`}>
                <Icon name={topicIcon(g.topic)} size={18} />
                {g.topic}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {top.length > 0 && (
        <section class="top" aria-labelledby="top-h">
          <h2 id="top-h">Most asked</h2>
          <ul class="rows two">
            {top.map((a) => (
              <li>
                <a href={`/help/${a.slug}/`}>
                  {a.question}
                  <Icon name="chevron-right" size={20} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="groups">
        {groups.map((g) => (
          <section class="group" aria-labelledby={topicId(g.topic)}>
            <h2 id={topicId(g.topic)}>
              <span class="icon-badge"><Icon name={topicIcon(g.topic)} size={20} /></span>
              {g.topic}
            </h2>
            <ul class="rows">
              {g.articles.map((a) => (
                <li>
                  <a href={`/help/${a.slug}/`}>
                    {a.question}
                    <Icon name="chevron-right" size={20} />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <div class="card missing">
        <span class="icon-badge"><Icon name="message-circle" size={22} /></span>
        <div>
          <h2>Didn't find it?</h2>
          <p class="muted">Ask the automated assistant, or call or text us for a straight answer.</p>
        </div>
        <a class="btn secondary" href="/ask/">
          Ask a question
          <Icon name="arrow-right" size={18} />
        </a>
      </div>
    </div>
  </div>

  <BookCall heading="Want us to take a look?" />
</Base>

<script>
  import { search, type SearchDoc } from '../../help/search';
  import { ICONS } from '../../icons/data';

  const form = document.querySelector<HTMLFormElement>('[data-search]');
  const input = document.getElementById('help-q') as HTMLInputElement | null;
  const list = document.getElementById('help-results') as HTMLOListElement | null;
  const status = document.getElementById('help-status');
  const raw = document.getElementById('help-index')?.textContent ?? '[]';
  const docs = JSON.parse(raw) as SearchDoc[];

  function chevron(): SVGSVGElement {
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    const attrs = { viewBox: '0 0 24 24', width: '20', height: '20', fill: 'none', stroke: 'currentColor', 'stroke-width': '2', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true', class: 'icon' };
    for (const [k, v] of Object.entries(attrs)) svg.setAttribute(k, v);
    svg.innerHTML = ICONS['chevron-right'];
    return svg;
  }

  function render(query: string) {
    if (!list || !status) return;
    list.replaceChildren();
    const q = query.trim();
    if (!q) {
      list.hidden = true;
      status.textContent = '';
      return;
    }
    const hits = search(docs, q);
    for (const hit of hits) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `/help/${hit.slug}/`;
      a.append(hit.q, chevron());
      li.append(a);
      list.append(li);
    }
    list.hidden = hits.length === 0;
    status.textContent =
      hits.length === 0
        ? 'No answer matches that yet. Try other words, or call or text us.'
        : `${hits.length} ${hits.length === 1 ? 'answer' : 'answers'} found.`;
  }

  input?.addEventListener('input', () => render(input.value));
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    render(input?.value ?? '');
  });
  const initial = new URLSearchParams(location.search).get('q');
  if (initial && input) {
    input.value = initial;
    render(initial);
  }
</script>

<style>
  /* Search, in the page header. */
  .search {
    display: grid;
    gap: 0.5rem;
    max-width: 40rem;
    margin-top: 1.5rem;
  }
  .search label {
    font-size: var(--text-s);
  }
  .search-field {
    position: relative;
  }
  .search-field :global(.icon) {
    position: absolute;
    left: 1.15rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--muted);
    pointer-events: none;
  }
  .search-field input {
    min-height: 3.75rem;
    padding-left: 3.25rem;
    border-radius: var(--pill);
    box-shadow: var(--shadow-2);
  }
  .search .hint {
    margin: 0;
  }
  .search .hint:empty {
    margin-top: -0.5rem;
  }
  .results {
    margin: 0;
  }

  /* The topic links sit close under the search box. */
  .under-search {
    padding-top: 0.75rem;
  }

  /* Topics: jump links. */
  .topics ul {
    list-style: none;
    padding: 0;
    margin: 0 0 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .topics a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 1rem 0.4rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--pill);
    background: var(--card);
    color: var(--ink);
    font-size: var(--text-s);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .topics a:hover {
    border-color: var(--brand);
    background: var(--brand-soft);
  }
  .topics :global(.icon) {
    color: var(--link);
  }

  h2 {
    font-size: var(--h3);
    line-height: 1.2;
    margin-bottom: 0.85rem;
  }
  .top {
    margin-bottom: 2.75rem;
  }
  .top h2 {
    font-size: var(--h2-s);
  }
  .group h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .group .icon-badge {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
  }
  .group {
    margin-bottom: 2.25rem;
    break-inside: avoid;
  }
  @media (min-width: 62rem) {
    .groups {
      columns: 2;
      column-gap: 2.5rem;
    }
  }

  .missing {
    display: grid;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
    padding: 1.35rem;
  }
  .missing h2 {
    margin-bottom: 0.15rem;
  }
  .missing p {
    margin: 0;
  }
  @media (min-width: 40rem) {
    .missing {
      grid-template-columns: auto 1fr auto;
      gap: 1.25rem;
      padding: 1.5rem 1.75rem;
    }
  }
</style>
