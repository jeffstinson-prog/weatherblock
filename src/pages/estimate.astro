---
import Base from '../layouts/Base.astro';
import BookCall from '../components/BookCall.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import EstimateApp from '../estimate/EstimateApp';
import '../styles/booking.css';
import { facts, has, smsHref, telHref } from '../facts';

const e = facts.estimate;
const d = facts.derived;
const { inspection, reviews } = facts;
const tel = telHref();
const sms = smsHref();
const props = {
  cta: d.estimateCta,
  bookHref: '/estimate/book/',
  businessName: facts.business.name,
  phone: facts.contact.phone,
  phoneHref: tel,
  serviceAreaShort: facts.serviceArea.short,
  callback: d.estimateCallback,
  free: inspection.free,
};
const free = inspection.free ? 'free ' : '';
// The page says up front what happens: a call, not a price on the screen (unless the facts file turns the ballpark on).
const lede = e.showBallpark
  ? `Enter your address and how to reach you, and see a rough price range for a new roof with ${e.material}. Then one of us calls to set up your written estimate.`
  : `Start with your address. We find your roof from above, then one of us calls you to set up your ${free}estimate.`;
const description = `${d.estimateTitle} in ${facts.serviceArea.short}. Enter your address and we call you to set up a roof inspection and a written estimate.`;
const google = reviews.google;
// Only what the facts file backs up.
const ticks = [
  ...(inspection.free ? ['The estimate is free'] : []),
  ...(inspection.byDrone ? ['We inspect by drone, with no foot traffic on your shingles'] : []),
  ...(inspection.deliverables ? [`You get ${inspection.deliverables}`] : []),
];
const showReviews = has('reviews.google.url') && google.rating !== null && google.count !== null;
---

{e.on ? (
  <Base title={d.estimateTitle} description={description} focus>
    <div class="flow">
      <div class="wrap flow-grid">
        <div class="flow-main">
          <header class="flow-head">
            <h1>{d.estimateTitle}</h1>
            <p>{lede}</p>
          </header>
          <EstimateApp client:load {...props} />
          <noscript>
            <p>This page needs JavaScript. Call or text {facts.contact.phone} and we'll set up your estimate.</p>
          </noscript>
          <ul class="ticks reassure">
            {ticks.map((line) => (
              <li>
                <Icon name="check" size={18} stroke={2.5} />
                <span>{line}</span>
              </li>
            ))}
            {showReviews && (
              <li>
                <Icon name="star" size={18} />
                <span>
                  {google.rating!.toFixed(1)} stars on Google from {google.count} reviews
                </span>
              </li>
            )}
          </ul>
          <p class="talk-line">
            Prefer to talk? {tel && <a href={tel}>Call {facts.contact.phone}</a>}{sms && <> or <a href={sms}>text us</a></>}.
          </p>
        </div>
        <aside class="flow-side" aria-label="How it works">
          <div class="card">
            <h2>How it works</h2>
            <ol class="steps">
              <li>Enter your address. We find your roof from above.</li>
              <li>Tell us how to reach you.</li>
              <li>One of us calls to set up your {free}estimate: a roof inspection, then a written price.</li>
            </ol>
          </div>
          <p class="talk">Your price is the one in your written estimate after {d.theInspection}.</p>
        </aside>
      </div>
    </div>
  </Base>
) : (
  <Base title="Roof estimate" description={`Prices come in a written estimate after ${d.theInspection}.`}>
    <PageHero title="Roof estimate" lede={`Prices come in a written estimate after ${d.theInspection}.`} />
    <BookCall />
  </Base>
)}

<style>
  .reassure {
    margin: 1.75rem 0 0;
    font-size: var(--text-s);
  }
  .talk-line {
    margin: 1rem 0 0;
    font-size: var(--text-s);
    color: var(--muted);
  }
  .talk-line a {
    font-weight: 650;
  }
  .flow-side .steps {
    margin: 0;
    font-size: var(--text-s);
  }
</style>
