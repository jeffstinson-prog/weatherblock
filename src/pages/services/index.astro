---
import Base from '../../layouts/Base.astro';
import BookCall from '../../components/BookCall.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { facts } from '../../facts';
import { serviceMeta } from '../../lib/services';
---

<Base title="Services" description={`Roof replacement, repairs, storm damage and drone inspections in ${facts.serviceArea.short}.`}>
  <PageHero title="Services" lede={`Everything starts with ${facts.derived.anInspection}.`} />

  <section class="section tight" aria-label="Our services">
    <div class="wrap">
      <ul class="services">
        {facts.services.map((s) => {
          const meta = serviceMeta(s.key);
          return (
            <li class="card link">
              <span class="icon-badge"><Icon name={meta.icon} size={26} /></span>
              <div>
                <h2><a class="cover" href={s.path}>{s.name}</a></h2>
                {meta.blurb && <p class="muted">{meta.blurb}</p>}
              </div>
              <span class="go" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section sand" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">From booking to a written estimate</h2>
      </div>
      <HowItWorks />
    </div>
  </section>

  <BookCall />
</Base>

<style>
  .services {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .services .card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.1rem;
    padding: 1.25rem;
  }
  .services .icon-badge {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 16px;
    align-self: start;
  }
  .services h2 {
    font-size: var(--h3);
    line-height: 1.2;
    margin: 0 0 0.2rem;
  }
  .services p {
    margin: 0;
  }
  .go {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--link);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .card.link:hover .go {
    transform: translateX(4px);
    background: var(--brand);
    color: var(--on-brand);
  }
  @media (min-width: 48rem) {
    .services {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .services .card {
      padding: 1.75rem;
      gap: 1.35rem;
    }
    .services h2 {
      font-size: clamp(1.4rem, 1.1rem + 1vw, 1.7rem);
    }
  }
</style>
