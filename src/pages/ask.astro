---
import Base from '../layouts/Base.astro';
import AskCard from '../components/AskCard.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import AskApp from '../assistant/AskApp';
import '../styles/booking.css';
import { facts, telHref } from '../facts';
import { topArticles } from '../help/load';

// A few of the most asked questions to start from. (None may contain the word on the Ask button.)
const starters = topArticles()
  .map((a) => a.question)
  .filter((q) => !/ask/i.test(q) && q.length <= 60)
  .slice(0, 4);
---

<Base title="Ask a question" description="An automated assistant that answers from our help center.">
  <PageHero title="Ask a question" lede="An automated assistant that answers from our help center." crumbs={[{ href: '/help/', label: 'Help center' }]} />

  <div class="section tight">
    <div class="wrap split">
      <div class="tool">
        <AskApp client:load phone={facts.contact.phone} phoneHref={telHref()} bookLabel={facts.derived.bookLabel} starters={starters} />
        <noscript><p>The assistant needs JavaScript. <a href="/help/">Search the help center</a> or call {facts.contact.phone}.</p></noscript>
        <p class="browse">
          <a class="more-link" href="/help/">
            <Icon name="book-open" size={18} />
            Prefer to browse? All answers in the help center
          </a>
        </p>
      </div>
      <aside class="side" aria-label="Talk to a person">
        <AskCard heading="Rather talk to a person?" assistant={false} />
      </aside>
    </div>
  </div>
</Base>

<style>
  .tool {
    max-width: 40rem;
  }
  .browse {
    margin: 1.5rem 0 0;
  }
</style>
