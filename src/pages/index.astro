---
import Base from '../layouts/Base.astro';
import BookCall from '../components/BookCall.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import type { IconName } from '../icons/data';
import { facts, formatDate, has, smsHref, telHref } from '../facts';
import { getArticle, topArticles } from '../help/load';
import { roofingContractor } from '../lib/schema-org';
import { serviceMeta } from '../lib/services';

const tel = telHref();
const sms = smsHref();
const { inspection, insuranceClaims, reviews, estimate } = facts;
const google = reviews.google;
const showReviews = has('reviews.google.url') && google.rating !== null && google.count !== null;
const questions = topArticles().slice(0, 6);
const insuranceAnswer = getArticle('insurance-pay');
const nc2027 = getArticle('nc-2027-changes');
const estimateOn = estimate.on;

// The headline is one of the business's own lines, one sentence to a line.
const headline = facts.business.lines[1] ?? facts.business.name;
const sentences = headline.match(/[^.!?]+[.!?]*/g)?.map((s) => s.trim()).filter(Boolean) ?? [headline];

const trust: { icon: IconName; text: string }[] = [
  ...(inspection.free ? [{ icon: 'badge-check' as IconName, text: 'Free inspection' }] : []),
  ...(inspection.byDrone ? [{ icon: 'drone' as IconName, text: 'By drone, with no foot traffic on your shingles' }] : []),
  ...(inspection.homeNotRequired ? [{ icon: 'house' as IconName, text: "You don't have to be home" }] : []),
];
---

<Base
  title={facts.business.name}
  description={`Roof repairs, replacements and ${facts.derived.anInspection} in ${facts.serviceArea.short}. Book online in about a minute.`}
  jsonLd={roofingContractor(Astro.site)}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{facts.serviceArea.short}</p>
        <h1>
          {sentences.map((s, i) => (
            <span class:list={['h1-line', { accent: i === sentences.length - 1 && sentences.length > 1 }]}>{s}{' '}</span>
          ))}
        </h1>
        <p class="lede">
          Roof repairs and replacements. Book {inspection.free ? 'a free roof inspection' : 'a roof inspection'} online in about a minute.
        </p>
        <div class="hero-actions" data-cta-zone>
          <a class="btn lg book" href="/book/">
            {facts.derived.bookLabel}
            <Icon name="arrow-right" size={20} />
          </a>
          {estimateOn && (
            <a class="btn secondary" href="/estimate/">
              <Icon name="ruler" size={18} />
              {facts.derived.estimateName}
            </a>
          )}
          {tel && (
            <a class="btn secondary call" href={tel}>
              <Icon name="phone" size={18} />
              Call
            </a>
          )}
        </div>
        {/* A phone gets a Call button, so the line under it offers texting. A desktop gets both in the line. */}
        {sms && (
          <p class="or-text on-phone">
            Prefer to text? <a href={sms}>Text {facts.contact.phone}</a>.
          </p>
        )}
        {tel && (
          <p class="or-text on-desk">
            Or call <a href={tel}>{facts.contact.phone}</a>{sms && <>, or <a href={sms}>send a text</a></>}.
          </p>
        )}
        <ul class="trust">
          {showReviews && (
            <li class="rating-line">
              <Stars rating={google.rating!} size={18} />
              <span>
                <strong>{google.rating!.toFixed(1)}</strong> on Google from {google.count} reviews
              </span>
            </li>
          )}
          {trust.map((t) => (
            <li>
              <Icon name={t.icon} size={18} />
              <span>{t.text}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-side">
        <section class="times" aria-labelledby="times-h" data-next-times data-state="loading">
          <h2 id="times-h">
            <span class="live" aria-hidden="true"></span>
            Next open times
          </h2>
          <ul class="times-list" data-times-list>
            <li class="ghost-row" aria-hidden="true"></li>
            <li class="ghost-row" aria-hidden="true"></li>
            <li class="ghost-row" aria-hidden="true"></li>
          </ul>
          <template data-arrow><Icon name="arrow-right" size={18} /></template>
          <p class="times-foot">
            <span class="times-note">{inspection.windowHours} hour arrival windows{inspection.free ? '. Free.' : '.'}</span>
            <a class="more-link" href="/book/">
              See all times
              <Icon name="arrow-right" size={18} />
            </a>
          </p>
        </section>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-h">From booking to a written estimate</h2>
      </div>
      <HowItWorks />
    </div>
  </section>

  <section class="section sand" aria-labelledby="services-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2 id="services-h">What we do</h2>
      </div>
      <ul class="cards services">
        {facts.services.map((s) => (
          <li class="card link">
            <span class="icon-badge"><Icon name={serviceMeta(s.key).icon} size={22} /></span>
            <h3><a class="cover" href={s.path}>{s.name}</a></h3>
            {serviceMeta(s.key).blurb && <p class="muted">{serviceMeta(s.key).blurb}</p>}
            <span class="card-arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {estimateOn && (
    <section class="section" aria-labelledby="est-h">
      <div class="wrap">
        <div class="estimate-band">
          <div class="estimate-copy">
            <p class="eyebrow on-dark">{facts.derived.estimateName}</p>
            <h2 id="est-h">Start your estimate with your address</h2>
            {estimate.showBallpark ? (
              <p>
                Enter your address and how to reach you, and see a rough price range for a new roof with {estimate.material}. Then one of us
                calls {facts.derived.estimateCallback} to set up your written estimate.
              </p>
            ) : (
              <p>
                Enter your address and we find your roof from above. Then one of us calls you {facts.derived.estimateCallback} to set up your{' '}
                {inspection.free ? 'free ' : ''}estimate: a roof inspection, then a written price.
              </p>
            )}
            <a class="btn light lg" href="/estimate/">
              {facts.derived.estimateCta}
              <Icon name="arrow-right" size={20} />
            </a>
          </div>
          <div class="roof-plan" aria-hidden="true">
            <!-- A hip roof seen from above, with its measuring marks. A drawing, not anyone's house. -->
            <svg viewBox="0 0 380 270" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <g class="plan-grid">
                <path d="M10 45h360M10 90h360M10 135h360M10 180h360M10 225h360M55 10v250M100 10v250M145 10v250M190 10v250M235 10v250M280 10v250M325 10v250" />
              </g>
              <g class="plan-courses">
                <path d="M85 85h200M105 105h160M122 122h126M85 185h200M105 165h160M122 148h126" />
                <path d="M85 85v100M105 105v60M122 122v26M285 85v100M265 105v60M248 122v26" />
              </g>
              <g class="plan-roof">
                <path d="M60 60h250v150H60z" />
                <path d="M60 60l75 75M60 210l75-75M310 60l-75 75M310 210l-75-75M135 135h100" />
              </g>
              <g class="plan-marks">
                <path d="M60 34h250M60 27v14M310 27v14M338 60v150M331 60h14M331 210h14" />
                <circle cx="60" cy="60" r="4.5" />
                <circle cx="310" cy="60" r="4.5" />
                <circle cx="310" cy="210" r="4.5" />
                <circle cx="60" cy="210" r="4.5" />
              </g>
            </svg>
          </div>
        </div>
      </div>
    </section>
  )}

  {showReviews && (
    <section class="section tight" aria-labelledby="reviews-h">
      <div class="wrap">
        <div class="reviews">
          <div class="reviews-score">
            <p class="score" aria-hidden="true">{google.rating!.toFixed(1)}</p>
            <Stars rating={google.rating!} size={26} />
          </div>
          <div class="reviews-copy">
            <h2 id="reviews-h">Reviews</h2>
            <p class="rating">
              {google.rating!.toFixed(1)} stars on Google from {google.count} reviews
              {google.asOf && <span class="muted"> as of {formatDate(google.asOf)}</span>}.
            </p>
            <p class="reviews-links">
              <a class="more-link" href={google.url} rel="noopener">
                Read them on Google
                <Icon name="arrow-up-right" size={18} />
              </a>
              {has('credentials.registration.id') && (
                <a class="more-link" href="/about/#check">
                  Check us yourself
                  <Icon name="arrow-right" size={18} />
                </a>
              )}
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section tint-blue" aria-labelledby="claims-h">
    <div class="wrap claims">
      <div>
        <p class="eyebrow">Storm damage and insurance</p>
        <h2 id="claims-h">Straight talk about insurance</h2>
        <p class="lede">{insuranceClaims.weDo} {insuranceClaims.youDo}</p>
        <p>We can't promise what insurance will pay. That part is up to your insurance company.</p>
        {insuranceAnswer && (
          <a class="more-link" href={`/help/${insuranceAnswer.slug}/`}>
            {insuranceAnswer.question}
            <Icon name="arrow-right" size={18} />
          </a>
        )}
      </div>
      {nc2027 && (
        <aside class="card dated">
          <span class="icon-badge"><Icon name="calendar-clock" size={22} /></span>
          <h3>June 1, 2027</h3>
          <p>North Carolina homeowners policies that start or renew on or after June 1, 2027 pay for roof damage differently.</p>
          <a class="more-link" href={`/help/${nc2027.slug}/`}>
            What the change means for your roof
            <Icon name="arrow-right" size={18} />
          </a>
        </aside>
      )}
    </div>
  </section>

  {questions.length > 0 && (
    <section class="section" aria-labelledby="q-h">
      <div class="wrap questions">
        <div class="section-head">
          <p class="eyebrow">Help center</p>
          <h2 id="q-h">Common questions</h2>
          <p class="lede">One plain answer per question.</p>
        </div>
        <div>
          <ul class="rows">
            {questions.map((a) => (
              <li>
                <a href={`/help/${a.slug}/`}>
                  {a.question}
                  <Icon name="chevron-right" size={20} />
                </a>
              </li>
            ))}
          </ul>
          <p class="q-links">
            <a class="more-link" href="/help/">
              All answers in the help center
              <Icon name="arrow-right" size={18} />
            </a>
            <a class="more-link" href="/ask/">
              Ask a question
              <Icon name="message-circle" size={18} />
            </a>
          </p>
          {facts.financing.url && (
            <p class="fin">
              <span class="icon-badge green"><Icon name="wallet" size={20} /></span>
              <span>
                <strong>Financing.</strong> You can check financing options through {facts.financing.provider}.{' '}
                <a href="/financing/">How financing works</a>
              </span>
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  <BookCall />
</Base>

<script>
  // The hero's "Next open times": the three soonest windows, straight from the
  // booking calendar. Tapping one starts a booking with that time already picked.
  import { dayKey, shortDay, windowLabel } from '../booking/format';

  interface Slot {
    id: string;
    startsAt: string;
    endsAt: string;
  }

  const card = document.querySelector<HTMLElement>('[data-next-times]');
  const list = card?.querySelector<HTMLElement>('[data-times-list]');
  const arrow = card?.querySelector<HTMLTemplateElement>('template[data-arrow]')?.content.firstElementChild;
  if (card && list) {
    const today = dayKey(new Date().toISOString());
    const tomorrow = dayKey(new Date(Date.now() + 86_400_000).toISOString());
    const dayLabel = (iso: string) => (dayKey(iso) === today ? 'Today' : dayKey(iso) === tomorrow ? 'Tomorrow' : shortDay(iso));

    const row = (s: Slot) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '/book/';
      a.dataset.slot = JSON.stringify({ id: s.id, startsAt: s.startsAt, endsAt: s.endsAt });
      const day = document.createElement('span');
      day.className = 'd';
      day.textContent = dayLabel(s.startsAt);
      const time = document.createElement('span');
      time.className = 't';
      time.textContent = windowLabel(s.startsAt, s.endsAt);
      a.append(day, time);
      if (arrow) a.append(arrow.cloneNode(true));
      li.append(a);
      return li;
    };

    fetch('/api/slots', { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? (r.json() as Promise<{ slots: Slot[] }>) : Promise.reject(new Error('no times'))))
      .then(({ slots }) => {
        if (slots.length === 0) throw new Error('no times');
        list.replaceChildren(...slots.slice(0, 3).map(row));
        card.dataset.state = 'ready';
      })
      .catch(() => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '/book/';
        a.textContent = 'See open times on the booking page';
        li.append(a);
        list.replaceChildren(li);
        card.dataset.state = 'none';
      });

    list.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-slot]');
      if (!a) return;
      try {
        sessionStorage.setItem('slot-handoff-v1', a.dataset.slot!);
      } catch {
        // Private browsing: the booking page still opens, just without the time picked.
      }
    });
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2rem, 6vw, 5rem) clamp(2.5rem, 7vw, 5.5rem);
    background:
      radial-gradient(46rem 26rem at 100% -10%, color-mix(in srgb, var(--logo-green) 30%, transparent), transparent 70%),
      radial-gradient(40rem 26rem at -10% 0%, color-mix(in srgb, var(--logo-blue) 20%, transparent), transparent 70%),
      linear-gradient(180deg, var(--mist) 0%, var(--paper) 78%);
  }
  /* Standing seams, like a metal roof, fading out toward the text. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: repeating-linear-gradient(112deg, color-mix(in srgb, var(--logo-blue) 15%, transparent) 0 1.5px, transparent 1.5px 36px);
    -webkit-mask-image: radial-gradient(70rem 34rem at 100% 0%, #000 0%, transparent 72%);
    mask-image: radial-gradient(70rem 34rem at 100% 0%, #000 0%, transparent 72%);
  }
  .hero-grid {
    display: grid;
    gap: 2rem;
  }
  h1 {
    font-size: var(--display);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 0.4em;
  }
  .h1-line {
    display: block;
  }
  .h1-line.accent {
    color: var(--link);
  }
  .hero .lede {
    margin-bottom: 1.5rem;
  }
  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }
  .hero-actions .book {
    grid-column: 1 / -1;
  }
  .hero-actions .btn.secondary {
    padding-inline: 0.75rem;
    font-size: var(--text-s);
  }
  .hero-actions .btn.secondary:only-of-type,
  .hero-actions .btn.secondary:last-child:nth-child(2) {
    grid-column: 1 / -1;
  }
  .or-text {
    margin: 0.85rem 0 0;
    font-size: var(--text-s);
    color: var(--muted);
  }
  .or-text a {
    font-weight: 650;
  }
  .or-text.on-desk {
    display: none;
  }
  .trust {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.6rem;
    font-size: var(--text-s);
    color: var(--ink-2);
  }
  .trust li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .trust :global(.icon) {
    color: var(--ok);
  }
  .trust strong {
    font-weight: 700;
    color: var(--ink);
  }

  /* Next open times */
  .times {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    padding: 1.15rem;
    box-shadow: var(--shadow-3);
  }
  .times h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0.15rem 0.2rem 0.85rem;
  }
  /* A small green light: these times are read from the calendar as the page opens. */
  .live {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    margin-inline: 0.15rem 0.1rem;
    border-radius: 50%;
    background: #2f9e7f;
  }
  .live::after {
    content: '';
    position: absolute;
    inset: -0.3rem;
    border-radius: 50%;
    border: 2px solid #2f9e7f;
    opacity: 0;
    animation: ping 2.4s ease-out infinite;
  }
  @keyframes ping {
    0% {
      transform: scale(0.5);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(1.15);
      opacity: 0;
    }
  }
  .times-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .times-list :global(li) {
    min-height: 3.5rem;
  }
  .times-list :global(a) {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.6rem 0.9rem 0.6rem 1rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-m);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .times-list :global(a:hover) {
    border-color: var(--brand);
    background: var(--brand-soft);
  }
  .times-list :global(a:active) {
    transform: scale(0.99);
  }
  .times-list :global(.d) {
    font-weight: 700;
  }
  .times-list :global(.t) {
    color: var(--ink-2);
  }
  .times-list :global(.icon) {
    color: var(--link);
  }
  .ghost-row {
    border-radius: var(--radius-m);
    background: linear-gradient(100deg, var(--sand) 30%, var(--paper) 50%, var(--sand) 70%);
    background-size: 300% 100%;
    animation: shimmer 1.4s ease-in-out infinite;
  }
  @keyframes shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0 0;
    }
  }
  .times-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0.6rem 0.2rem 0;
    font-size: var(--text-s);
  }
  .times-note {
    color: var(--muted);
  }
  /* The list is filled in by script; without it, the buttons above do the job. */
  @media (scripting: none) {
    .times {
      display: none;
    }
  }

  /* A tilted roof plane behind the card, for depth. */
  .hero-side {
    position: relative;
    isolation: isolate;
  }
  .hero-side::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -1.25rem -0.5rem 1.25rem 1.5rem;
    border-radius: var(--radius-xl);
    background:
      repeating-linear-gradient(112deg, rgb(255 255 255 / 0.22) 0 1.5px, transparent 1.5px 30px),
      linear-gradient(140deg, color-mix(in srgb, var(--logo-blue) 55%, transparent), color-mix(in srgb, var(--logo-green) 60%, transparent));
    transform: rotate(3deg);
    opacity: 0.55;
  }

  @media (min-width: 62rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 4rem;
      align-items: center;
    }
    h1 {
      font-size: clamp(2.75rem, 4.6vw, 3.9rem);
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
    }
    .hero-actions .btn.secondary {
      padding-inline: 1.25rem;
      font-size: inherit;
    }
    /* The header carries the phone number on a desktop. */
    .hero-actions .call,
    .or-text.on-phone {
      display: none;
    }
    .or-text.on-desk {
      display: block;
    }
    .hero-side::before {
      inset: -2rem -1.5rem 2rem 2.5rem;
    }
    .trust {
      grid-template-columns: repeat(2, minmax(0, max-content));
      gap: 0.6rem 2rem;
    }
    .times {
      padding: 1.5rem;
    }
  }

  /* Services: rows on a phone, cards side by side on a desktop. */
  .services .card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 1rem;
    padding: 1.1rem 1.15rem;
  }
  .services .icon-badge {
    grid-row: span 2;
    align-self: start;
  }
  .services h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .services p {
    grid-column: 2;
    margin: 0.15rem 0 0;
    font-size: var(--text-s);
  }
  .card-arrow {
    grid-column: 3;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--link);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .card.link:hover .card-arrow {
    transform: translateX(4px);
    background: var(--brand);
    color: var(--on-brand);
  }
  @media (min-width: 62rem) {
    .services {
      grid-template-columns: repeat(4, 1fr);
    }
    .services .card {
      grid-template-columns: 1fr;
      align-content: start;
      row-gap: 0.25rem;
      padding: 1.35rem;
    }
    .services .icon-badge {
      grid-row: auto;
    }
    .services h3 {
      margin-top: 0.85rem;
      font-size: var(--h3);
    }
    .services p {
      grid-column: 1;
      font-size: inherit;
    }
    .card-arrow {
      grid-column: 1;
      grid-row: auto;
      margin-top: 1rem;
    }
  }

  /* The estimate band */
  .estimate-band {
