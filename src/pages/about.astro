---
import Base from '../layouts/Base.astro';
import BookCall from '../components/BookCall.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { canClaimInsured, canClaimLicense, facts, formatDate, has } from '../facts';
import { roofingContractor } from '../lib/schema-org';
import { getArticle } from '../help/load';
const fortifiedAnswer = getArticle('fortified');
const { business, credentials } = facts;
const google = facts.reviews.google;
const showReviews = has('reviews.google.url') && google.rating !== null && google.count !== null;
const showRegistration = has('credentials.registration.id');
const showCheck = showRegistration || canClaimLicense() || showReviews;

// Only what the facts file backs up.
const backed: { label: string; value: string }[] = [
  ...(canClaimInsured() ? [{ label: 'Insurance', value: credentials.insurance.liability }] : []),
  ...(has('credentials.insurance.workersComp') ? [{ label: "Workers' compensation", value: credentials.insurance.workersComp }] : []),
  ...(has('credentials.warranty.workmanship') ? [{ label: 'Warranty', value: credentials.warranty.workmanship }] : []),
  ...(credentials.certifications.length > 0 ? [{ label: 'Certifications', value: credentials.certifications.join(', ') }] : []),
];
---

<Base title="About us" description={`${business.name} is owned by ${facts.derived.ownerNames}, based in ${business.city}, ${business.state}.`} jsonLd={roofingContractor(Astro.site)}>
  <PageHero title="About us" lede={business.lines[0]} />

  <div class="section tight">
    <div class="wrap about">
      <div class="prose">
        <p class="who">
          {business.name} is owned by {facts.derived.ownerNames}. {facts.derived.ownerRoles} We're based in {business.city}, {business.state}, and we serve {facts.serviceArea.summary}.
        </p>
        {backed.length > 0 && (
          <dl class="backed">
            {backed.map((b) => (
              <div>
                <dt>{b.label}</dt>
                <dd>{b.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {credentials.fortified.inProgress && !credentials.fortified.certified && (
          <p>
            We're working on our FORTIFIED roofing certification.
            {fortifiedAnswer && <> <a href={`/help/${fortifiedAnswer.slug}/`}>What a FORTIFIED roof is</a>.</>}
          </p>
        )}
        {business.legalName && !showRegistration && <p class="small muted">{business.legalName}</p>}
      </div>

      {business.verse.text && (
        <figure class="verse">
          <Icon name="quote" size={28} />
          <blockquote>
            <p>{business.verse.text}</p>
          </blockquote>
          <figcaption>{business.verse.ref}</figcaption>
        </figure>
      )}
    </div>
  </div>

  {showCheck && (
    <section class="section sand" aria-labelledby="check">
      <div class="wrap">
        <div class="section-head">
          <h2 id="check">Check us yourself</h2>
          <p class="lede">Public records and reviews you can look up on your own.</p>
        </div>
        <ul class="cards checks">
          {showRegistration && (
            <li class="card">
              <span class="icon-badge"><Icon name="landmark" size={22} /></span>
              <h3>State registration</h3>
              <p>Registered in North Carolina as {business.legalName || business.name}, ID {credentials.registration.id}.</p>
              {credentials.registration.lookupUrl && (
                <p class="look">
                  <a href={credentials.registration.lookupUrl} rel="noopener">Search the NC Secretary of State</a> for "{business.name}".
                </p>
              )}
            </li>
          )}
          {canClaimLicense() && (
            <li class="card">
              <span class="icon-badge"><Icon name="id-card" size={22} /></span>
              <h3>License</h3>
              <p>{credentials.license.holder} holds {credentials.license.kind} license number {credentials.license.number}.</p>
              {credentials.license.lookupUrl && (
                <p class="look">
                  <a href={credentials.license.lookupUrl} rel="noopener">Look it up</a>.
                </p>
              )}
            </li>
          )}
          {showReviews && (
            <li class="card">
              <span class="icon-badge"><Icon name="star" size={22} /></span>
              <h3>Google reviews</h3>
              <p>
                {google.rating!.toFixed(1)} stars on Google from {google.count} reviews{google.asOf && <> as of {formatDate(google.asOf)}</>}.
              </p>
              <p class="look">
                <a href={google.url} rel="noopener">Read them on Google</a>.
              </p>
            </li>
          )}
        </ul>
      </div>
    </section>
  )}

  <BookCall />
</Base>

<style>
  .about {
    display: grid;
    gap: 2.5rem;
  }
  .who {
    font-size: var(--text-l);
    line-height: 1.55;
  }
  .backed {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--card);
  }
  .backed dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .backed dd {
    margin: 0;
  }

  /* The verse from the logo, set large on the deep ocean color. */
  .verse {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    align-self: start;
    margin: 0;
    padding: clamp(1.75rem, 5vw, 2.5rem);
    border-radius: var(--radius-xl);
    color: var(--on-night);
    background:
      radial-gradient(24rem 16rem at 100% 100%, color-mix(in srgb, var(--logo-green) 28%, transparent), transparent 70%),
      linear-gradient(135deg, var(--night), var(--night-2));
    box-shadow: var(--shadow-3);
  }
  .verse::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: repeating-linear-gradient(112deg, rgb(255 255 255 / 0.06) 0 1.5px, transparent 1.5px 34px);
  }
  .verse :global(.icon) {
    color: #8fd3c2;
  }
  .verse blockquote {
    margin: 1rem 0 0;
  }
  .verse blockquote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.25rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .verse figcaption {
    margin-top: 1.25rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-night-muted);
  }
  @media (min-width: 62rem) {
    .about {
      grid-template-columns: minmax(0, 1fr) 24rem;
      gap: clamp(3rem, 6vw, 5.5rem);
      align-items: start;
    }
  }

  .checks .card {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1.5rem;
  }
  .checks h3 {
    margin-top: 0.85rem;
  }
  .checks p {
    margin: 0;
    color: var(--ink-2);
  }
  .checks .look {
    margin-top: 0.6rem;
    font-size: var(--text-s);
  }
  .checks .look a {
    font-weight: 650;
  }
</style>
