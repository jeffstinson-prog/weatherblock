---
// Shared frame for the fine-print pages.
import Base from '../layouts/Base.astro';
import AskCard from './AskCard.astro';
import PageHero from './PageHero.astro';
import { formatDate } from '../facts';

interface Props {
  title: string;
  description: string;
  updated: string; // YYYY-MM-DD
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <PageHero title={title}>
    <p class="updated">Last updated {formatDate(updated)}</p>
  </PageHero>

  <div class="section tight">
    <div class="wrap split">
      <article class="prose legal">
        <slot />
      </article>
      <aside class="side" aria-label="Ask us">
        <AskCard heading="Questions about this page?" assistant={false} />
      </aside>
    </div>
  </div>
</Base>

<style>
  .updated {
    margin: 0;
    font-size: var(--text-s);
    color: var(--muted);
  }
  .legal {
    color: var(--ink-2);
  }
  .legal :global(h2),
  .legal :global(strong) {
    color: var(--ink);
  }
  .legal :global(h2) {
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.55rem);
    margin-top: 2em;
  }
</style>
