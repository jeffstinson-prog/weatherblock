---
// The closing section on most pages: the ways to get started.
import Icon from './Icon.astro';
import { facts, smsHref, telHref } from '../facts';

interface Props {
  heading?: string;
  text?: string;
}
const { heading = 'Book a free inspection', text } = Astro.props;
const tel = telHref();
const sms = smsHref();
const free = facts.inspection.free;
const line = text ?? `Pick a ${facts.inspection.windowHours} hour window that works for you. It takes about a minute.`;
---

<section class="book-call" data-cta-zone>
  <div class="wrap">
    <div class="panel">
      <div class="copy">
        <h2>{free ? heading : 'Book an inspection'}</h2>
        <p class="lede">{line}</p>
      </div>
      <div class="actions">
        <a class="btn light lg" href="/book/">
          {free ? 'Book a free inspection' : 'Book an inspection'}
          <Icon name="arrow-right" size={20} />
        </a>
        {tel && (
          <a class="btn outline-light lg" href={tel}>
            <Icon name="phone" size={18} />
            Call {facts.contact.phone}
          </a>
        )}
        {sms && (
          <a class="btn outline-light lg" href={sms}>
            <Icon name="message-square" size={18} />
            Text us
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .book-call {
    padding-block: calc(var(--section) * 0.6) var(--section);
  }
  .panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 6vw, 4rem);
    color: var(--on-night);
    background:
      radial-gradient(40rem 22rem at 100% 0%, color-mix(in srgb, var(--logo-green) 30%, transparent), transparent 70%),
      radial-gradient(36rem 24rem at 0% 100%, color-mix(in srgb, var(--logo-blue) 38%, transparent), transparent 70%),
      linear-gradient(135deg, var(--night), var(--night-2));
    box-shadow: var(--shadow-3);
    display: grid;
    gap: 1.5rem;
  }
  /* Standing seams, like a metal roof seen from the side. */
  .panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: repeating-linear-gradient(112deg, rgb(255 255 255 / 0.07) 0 1.5px, transparent 1.5px 34px);
    -webkit-mask-image: linear-gradient(100deg, transparent 30%, #000 100%);
    mask-image: linear-gradient(100deg, transparent 30%, #000 100%);
  }
  h2 {
    font-size: clamp(1.9rem, 1.3rem + 3vw, 3rem);
    margin-bottom: 0.4em;
    max-width: 18ch;
  }
  .lede {
    color: var(--on-night-muted);
    margin: 0;
  }
  .actions {
    margin: 0;
  }
  .panel :global(:focus-visible) {
    outline-color: #9bd6f5;
  }
  @media (min-width: 60rem) {
    .panel {
      grid-template-columns: 1.1fr auto;
      align-items: center;
      gap: 3rem;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
      min-width: 19rem;
    }
  }
</style>
