# Copy to .env for local work. Real keys live in Netlify's environment
# settings and in GitHub Actions secrets, never in this repo.
# Anything left blank falls back to a safe test mode (no real texts, emails,
# Google calls or uploads), except in production, where it is an error.

# production on the live site, preview on deploy previews, development locally
APP_ENV=development

# The site's public address. Used for links in messages, canonical links and the sitemap.
SITE_URL=https://weatherblockroofingnc.com

# Supabase
# Postgres connection string from Supabase: the pooler, transaction mode (port 6543).
DATABASE_URL=
# Project URL. The owner app signs in against it and phones upload photos to it.
PUBLIC_SUPABASE_URL=
# Publishable (anon) key, for the owner app's sign-in. Safe to be public.
PUBLIC_SUPABASE_ANON_KEY=
# Tests only: sign tokens with a shared secret instead of Supabase's published keys.
# SUPABASE_JWT_SECRET=
# Server only. Creates signed photo upload and view links.
SUPABASE_SERVICE_ROLE_KEY=
PHOTO_BUCKET=booking-photos

# Random secrets, 32+ characters each. Generate with: openssl rand -base64 32
MANAGE_TOKEN_SECRET=
RATE_LIMIT_SALT=

# Google Maps Platform
# Server key: Places API (New) only. Restrict it to that API.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: Maps Static API only, restricted to the site's domains. Plus its URL signing secret.
GOOGLE_MAPS_STATIC_KEY=
GOOGLE_MAPS_SIGNING_SECRET=

# Email: Resend. Blank means emails are only logged in the database, never sent.
RESEND_API_KEY=
# Defaults to "<business name> <bookings@<domain>>". The domain must be verified in Resend.
EMAIL_FROM=

# Texts: Twilio. Blank means texts are only logged, never sent.
# Test credentials (from the Twilio console) work too: Twilio accepts them and sends nothing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either the number we text from (+1...), or a Messaging Service for 10DLC.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Shared secret for the scheduled job (reminders, retries, clean-up). Random, 32+ characters.
CRON_SECRET=

# Google Calendar: a service account the owners' calendar is shared with
# ("Make changes to events"). The key is the private_key from its JSON file,
# with line breaks written as \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
# Optional: the calendar to use, if not set in the owner app.
GOOGLE_CALENDAR_ID=

# Seconds a real person needs to fill in the booking form (bots are faster).
BOT_MIN_SECONDS=4

# Lighthouse CI only: build as if launched so the SEO check can run. Never set on Netlify.
# FORCE_INDEXABLE=1
